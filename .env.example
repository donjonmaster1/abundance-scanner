# LegiScan API key — free tier, 30k queries/month. Register at https://legiscan.com/legiscan
LEGISCAN_API_KEY=

# Anthropic API key — used for Haiku triage pass and Sonnet summary pass
ANTHROPIC_API_KEY=

# Optional: Legistar client codes don't require a key, but some jurisdictions rate-limit
# aggressively without a token. Leave blank unless you hit 429s.
LEGISTAR_TOKEN=

# Optional: outbound digest email via Resend (https://resend.com), sent from
# a verified subdomain (scanner.abundancecorps.org). Recipients are managed
# in config/subscribers.yaml, not here. Leave both blank to skip email
# sending entirely.
EMAIL_FROM=digest@scanner.abundancecorps.org
RESEND_API_KEY=
