# LegiScan API key — free tier, 30k queries/month. Register at https://legiscan.com/legiscan
LEGISCAN_API_KEY=

# Anthropic API key — used for Haiku triage pass and Sonnet summary pass
ANTHROPIC_API_KEY=

# Optional: Legistar client codes don't require a key, but some jurisdictions rate-limit
# aggressively without a token. Leave blank unless you hit 429s.
LEGISTAR_TOKEN=

# Optional: outbound email for v2 digest delivery (unused in v1)
EMAIL_FROM=
EMAIL_TO=
RESEND_API_KEY=
